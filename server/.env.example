# Скопіюйте цей файл у .env і заповніть значеннями зі свого Supabase-проєкту.

# Supabase → Project Settings → Database → Connection string (URI, режим "Session pooler")
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Спільний логін для всієї команди — покажеться як вікно входу браузера.
APP_USER=bavys
APP_PASSWORD=change-me

PORT=4000
