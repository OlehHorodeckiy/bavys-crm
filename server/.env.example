# Скопіюйте цей файл у .env і заповніть значеннями зі свого Supabase-проєкту.

# Supabase → Project Settings → Database → Connection string (URI, режим "Session pooler")
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Вхід через Google. Якщо не заповнити — CRM доступна без входу (годиться лише
# для локальної розробки). Client ID береться з Google Cloud Console.
GOOGLE_CLIENT_ID=
# Через кому, без пробілів — email-адреси, яким дозволено вхід
ALLOWED_EMAILS=
# Довгий випадковий рядок для підпису сесій, напр.: openssl rand -hex 32
SESSION_SECRET=

# Синхронізація замовлень з Google Calendar (необов'язково — якщо не
# заповнити, ця фіча просто вимкнена). Секрет генерується на тому самому
# Client ID, що й GOOGLE_CLIENT_ID вище, в Google Cloud Console.
GOOGLE_CLIENT_SECRET=
# Email партнерки — саме її календар отримує події
CALENDAR_OWNER_EMAIL=

PORT=4000
